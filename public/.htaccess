# Nuhafrik SPA routing + social crawler prerender (cPanel/LiteSpeed)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Dynamic sitemap — always generate fresh product URLs.
  #    sitemap.xml is a real file in dist, so this rule must come before
  #    the "existing files" rule below.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # 2. Social/search crawlers get full meta tags + product image from PHP.
  #    Only non-file requests (product routes, /shop, /about, etc.) are routed.
  RewriteCond %{HTTP_USER_AGENT} "facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot|Pinterest|Googlebot|bingbot|Baiduspider|YandexBot|DuckDuckBot|Applebot|W3C_Validator|vkShare|embedly|redditbot|SkypeUriPreview|MicroMessenger|curl|python-requests|Google-InspectionTool|MegaIndex|ia_archiver|Snapchat|Line|Viber" [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ social-meta.php [L]

  # 3. Don't rewrite existing files (assets, images, robots.txt, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Everything else -> index.html (client-side BrowserRouter handles it)
  RewriteRule ^ index.html [L]
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Browser caching (hashed assets are safe to cache long-term)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>